# F051: eval fixtures staging is generated locally by `python -m nous_eval.ingest`
# and must NOT be shipped in the generic application image. It IS intentionally
# included by Dockerfile.eval-db via an explicit COPY.
# All other Dockerfiles must ignore it.
/nous-eval-fixtures-staging/

# F051: the `nous_eval` sibling package is a developer-only eval harness.
# The prod Dockerfile uses `COPY nous/ nous/` which already excludes this
# sibling directory; this ignore pattern is belt-and-braces for any future
# Dockerfile that uses a broader COPY . . pattern.
/nous_eval/

# Dashboard v2 (Svelte): node_modules is reinstalled by `npm ci` in the
# Dockerfile's dashboard build stage — never ship the host copy (~170MB).
# dist is a build artifact produced inside the image, not from the host.
dashboard-app/node_modules/
static/dashboard-v2/dist/

# Build-context bloat that no Dockerfile COPYs — excluded to speed builds.
.git/
.venv/
**/__pycache__/
tools/beam/.venv/
