# DB connection -- shared by docker-compose AND Python app
DB_HOST=localhost
DB_PORT=5432
DB_USER=nous
DB_PASSWORD=nous_dev_password
DB_NAME=nous

# LLM
ANTHROPIC_API_KEY=your_anthropic_key_here
# Dual auth: Bearer token takes precedence over API key
ANTHROPIC_AUTH_TOKEN=

# Embeddings (optional -- keyword-only search if omitted)
OPENAI_API_KEY=your_openai_key_here

# Web search (optional -- web_search tool disabled if omitted)
BRAVE_SEARCH_API_KEY=your_brave_search_key_here

# Agent
NOUS_AGENT_ID=nous-default
NOUS_AGENT_NAME=Nous

# Identity prompt — injected as the first section of every system prompt.
# This is how Nous knows who it is, what tools it has, and how to behave.
# Override to customize personality and behavior. Leave empty to use the built-in default.
# NOUS_IDENTITY_PROMPT=You are Nous, a cognitive AI agent that learns from experience...
NOUS_MODEL=claude-sonnet-4-5-20250514
NOUS_LOG_LEVEL=info

# Extended thinking (off = disabled, adaptive = model decides, manual = explicit budget)
NOUS_THINKING_MODE=off
NOUS_THINKING_BUDGET=10000
NOUS_EFFORT=high
NOUS_MCP_ENABLED=true
NOUS_PORT=8000

# Direct API settings
NOUS_MAX_TURNS=10
NOUS_API_BASE_URL=https://api.anthropic.com
NOUS_API_TIMEOUT_CONNECT=10
NOUS_API_TIMEOUT_READ=120
NOUS_TOOL_TIMEOUT=120
NOUS_KEEPALIVE_INTERVAL=10
NOUS_WORKSPACE_DIR=/tmp/nous-workspace

# Event Bus & Handlers
NOUS_EVENT_BUS_ENABLED=true
NOUS_EPISODE_SUMMARY_ENABLED=true
NOUS_FACT_EXTRACTION_ENABLED=true
NOUS_SLEEP_ENABLED=true
NOUS_BACKGROUND_MODEL=claude-sonnet-4-5-20250514
NOUS_SESSION_TIMEOUT=1800
NOUS_SLEEP_TIMEOUT=7200
NOUS_SLEEP_CHECK_INTERVAL=60

# Subtasks & Scheduling (F009)
NOUS_SUBTASK_ENABLED=true
NOUS_SUBTASK_WORKERS=2
NOUS_SUBTASK_POLL_INTERVAL=2
NOUS_SUBTASK_DEFAULT_TIMEOUT=120
NOUS_SUBTASK_MAX_TIMEOUT=600
NOUS_SUBTASK_MAX_CONCURRENT=3
NOUS_SCHEDULE_ENABLED=true
NOUS_SCHEDULE_CHECK_INTERVAL=60

# Context Quality (F016/F017)
# Override model context window in tokens (0 = auto-detect from model name)
# NOUS_CONTEXT_WINDOW=0
NOUS_ANTI_HALLUCINATION_PROMPT=true
NOUS_TOOL_PRUNING_ENABLED=true
NOUS_TOOL_SOFT_TRIM_CHARS=4000
NOUS_TOOL_SOFT_TRIM_HEAD=1500
NOUS_TOOL_SOFT_TRIM_TAIL=1500
NOUS_TOOL_METADATA_DEGRADE_AFTER=8
NOUS_TOOL_HARD_CLEAR_AFTER=12
NOUS_KEEP_LAST_TOOL_RESULTS=2
NOUS_COMPACTION_ENABLED=true
# Auto-scaled per model context window. Uncomment to override:
# NOUS_COMPACTION_THRESHOLD=100000
# NOUS_KEEP_RECENT_TOKENS=20000
NOUS_RELEVANCE_FLOOR_ENABLED=true
NOUS_RELEVANCE_DROP_RATIO=0.6
NOUS_BUDGET_SCALE_ENABLED=true
# Override per-frame context budget defaults (JSON dict).
# Applied on top of each frame's built-in defaults — only include keys you want to change.
#
# Token budgets (max estimated tokens per section):
#   total=8000, identity=500, user_profile=200, censors=300, frame=500,
#   working_memory=700, decisions=2000, facts=1500, procedures=1500, episodes=1000
#
# Turn budget (number of recent user turns checked for dedup, NOT tokens):
#   conversation_window=5
#
# Full structure with defaults:
# NOUS_CONTEXT_BUDGET_OVERRIDES={"total": 8000, "identity": 500, "user_profile": 200, "censors": 300, "frame": 500, "working_memory": 700, "decisions": 2000, "facts": 1500, "procedures": 1500, "episodes": 1000, "conversation_window": 5}
# NOUS_CONTEXT_BUDGET_OVERRIDES={}
NOUS_STALENESS_PENALTY_ENABLED=true
NOUS_STALENESS_HALF_LIFE_DAYS=14

# Telegram notifications (subtask completion/failure + bot interface)
# TELEGRAM_BOT_TOKEN is used by telegram_bot.py directly
# NOUS_TELEGRAM_BOT_TOKEN / NOUS_TELEGRAM_CHAT_ID are used by subtask notifications
TELEGRAM_BOT_TOKEN=
NOUS_TELEGRAM_BOT_TOKEN=
NOUS_TELEGRAM_CHAT_ID=

# Google Drive integration (service account)
# Option A (recommended): base64-encoded service account JSON key
#   Generate with: base64 -w0 service-account-key.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Option B: path to the JSON key file (if mounted into container)
# GOOGLE_SERVICE_ACCOUNT_PATH=/app/secrets/gcp-service-account.json

# Google Drive OAuth (preferred for uploads — authenticates as user)
# Create Desktop App OAuth credentials at console.cloud.google.com/apis/credentials
# Then run the one-time auth flow to get a refresh token.
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
