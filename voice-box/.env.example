# Copy to C:\voice\.env (setup.ps1 does this). Never commit the real file.
# Shared secret Nous presents to /stt and /tts. Empty = server refuses to start.
VOICE_BOX_TOKEN=
# 0.0.0.0 so the phone/Nous can reach it; restrict with the Windows Firewall
# rules in setup.ps1 (LAN + Tailscale only). Use 127.0.0.1 for local testing.
VOICE_BOX_HOST=0.0.0.0
VOICE_BOX_PORT=7860
# Speech-to-text
VOICE_BOX_STT_MODEL=turbo
VOICE_BOX_STT_DEVICE=cuda
VOICE_BOX_STT_COMPUTE=float16
# Text-to-speech (Kokoro ONNX files; downloaded by setup.ps1 into VOICE_BOX_MODEL_DIR)
VOICE_BOX_MODEL_DIR=C:\voice\models
VOICE_BOX_TTS_VOICE=af_nicole
# Load models at startup and hold VRAM (spec C3 rule 1). 0 = lazy, for testing.
VOICE_BOX_PRELOAD=1
# Ollama coexistence (spec C3 rule 4)
OLLAMA_URL=http://localhost:11434
VOICE_BOX_MIN_FREE_VRAM_MB=5000
# Upload cap for /stt in MB
VOICE_BOX_MAX_UPLOAD_MB=25
# Used by PR 7 (Pipecat bot), unused in PR 1:
NOUS_VOICE_URL=
NOUS_VOICE_TOKEN=
